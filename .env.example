# Colossal Engine — environment overrides.
# Copy to `.env` and edit as needed: `cp .env.example .env` (or copy on Windows).
# Real environment variables always take precedence over `.env`.

# Where bar parquet, DuckDB, and SQLite files live. Default: <repo_root>/data
# QUANT_DATA_DIR=

# Full path overrides (take precedence over QUANT_DATA_DIR).
# QUANT_RUNS_DB=
# QUANT_BARS_DB=
# QUANT_ARTIFACTS_DIR=

# CORS allowed origins for the API. Comma-separated. Default: * (local dev only).
# QUANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging.
# QUANT_LOG_LEVEL=INFO
# QUANT_LOG_JSON=0
